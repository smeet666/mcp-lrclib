{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smeet666/mcp-lrclib",
  "description": "Search tracks on LRCLIB and fetch plain or time-synced (LRC) lyrics. No API key.",
  "websiteUrl": "https://github.com/smeet666/mcp-lrclib#readme",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/smeet666/mcp-lrclib/main/assets/icon-128.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/smeet666/mcp-lrclib/main/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/smeet666/mcp-lrclib",
    "source": "github"
  },
  "version": "1.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-lrclib",
      "version": "1.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LRCLIB_USER_AGENT",
          "description": "Override the User-Agent sent to LRCLIB.",
          "isRequired": false
        },
        {
          "name": "LRCLIB_MIN_INTERVAL_MS",
          "description": "Minimum milliseconds between requests. Default 500, floor 200.",
          "isRequired": false
        },
        {
          "name": "LRCLIB_LOG_LEVEL",
          "description": "silent, error, info or debug. Default error.",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/smeet666/mcp-lrclib/releases/download/v1.4.0/mcp-lrclib-1.4.0.mcpb",
      "version": "1.4.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
